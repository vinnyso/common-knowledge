{
  "name": "common-knowledge",
  "version": "0.1.0",
  "description": "Git-native shared project knowledge for coding agents",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "common-knowledge": "dist/cli.js",
    "common-knowledge-mcp": "dist/mcp.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint:repo": "node scripts/lint-repository.mjs",
    "lint": "npm run typecheck && npm run lint:repo",
    "preflight": "npm run lint && npm run lint:types && npm run test:focused",
    "test:focused": "npm run build && node --test test/cli.test.mjs test/entry-lifecycle.test.mjs test/mcp.test.mjs",
    "test": "npm run build && node --test",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "benchmark:search": "npm run build && node scripts/benchmark-search.mjs",
    "lint:types": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "eslint": "10.10.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  }
}
