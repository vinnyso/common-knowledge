@@ -0,0 +1,19 @@
+package com.northstar.orders.persistence;
+
+import com.northstar.orders.application.DispatchOrders;
+import java.time.*;
+import java.util.List;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Repository;
+@Repository
+public class JdbcDispatchOrders implements DispatchOrders {
+    private final JdbcTemplate jdbc;
+    public JdbcDispatchOrders(JdbcTemplate jdbc) { this.jdbc=jdbc; }
+    public List<Row> eligibleBefore(Instant cutoff) {
+        return jdbc.query("""
+            SELECT o.id,o.customer_ref FROM sales_order o JOIN customer c ON c.id=o.customer_id
+            WHERE o.state_code='ALLOC' AND o.fulfilment_mode='WAREHOUSE' AND o.hold_reason IS NULL
+            AND c.credit_blocked=FALSE AND o.created_at<=? ORDER BY o.id
+            """,(rs,n)->new Row(rs.getLong(1),rs.getString(2)),OffsetDateTime.ofInstant(cutoff,ZoneOffset.UTC));
+    }
+}
