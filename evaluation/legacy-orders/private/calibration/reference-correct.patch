+package com.northstar.orders.web;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.northstar.orders.application.ImportReferenceService;
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.Positive;
+import java.util.Map;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.web.server.ResponseStatusException;
+
+@RestController
+@RequestMapping("/api/import/references")
+public class ReferenceImportController {
+    private final ImportReferenceService service;
+    public ReferenceImportController(ImportReferenceService service) { this.service=service; }
+    @PostMapping
+    public Map<String,Long> update(@Valid @RequestBody Request request) {
+        if(request.customerReference()==null || !request.customerReference().isTextual())
+            throw new ResponseStatusException(HttpStatus.BAD_REQUEST);
+        service.importReference(request.orderId(),request.customerReference().textValue());
+        return Map.of("orderId",request.orderId());
+    }
+    public record Request(@Positive long orderId,JsonNode customerReference) {}
+}
