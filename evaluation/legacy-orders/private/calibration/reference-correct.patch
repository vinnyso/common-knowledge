+package com.northstar.orders.application;
+
+import com.northstar.orders.domain.CustomerReference;
+import java.time.Clock;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+@Service
+public class ImportReferenceService {
+    private final OrderStore orders;
+    private final AuditLog audit;
+    private final Clock clock;
+    public ImportReferenceService(OrderStore orders,AuditLog audit,Clock clock) { this.orders=orders;this.audit=audit;this.clock=clock; }
+    @Transactional
+    public void importReference(long id,String value) {
+        var reference=new CustomerReference(value);
+        var order=orders.find(id).orElseThrow(()->new OrderNotFound(id));
+        if(!orders.replaceReference(id,order.version(),reference.value())) throw new ConcurrentOrderChange(id);
+        audit.append(id,"REFERENCE_AMENDED",reference.value(),clock.instant());
+    }
+}
